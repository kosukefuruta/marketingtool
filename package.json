{
  "name": "marketingtool",
  "private": true,
  "description": "URLを入力して技術SEO上の問題を診断するCLIツール",
  "type": "module",
  "scripts": {
    "seo:audit": "tsx src/audit.ts",
    "dev": "next dev -p 8000",
    "build": "next build",
    "start": "next start -p ${PORT:-8000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "3.1091.0",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "next": "16.2.10",
    "playwright": "1.62.1",
    "postgres": "3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "stripe": "22.3.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
